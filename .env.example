APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=service_history
DB_USERNAME=root
DB_PASSWORD=

# Database Connection Pooling Settings
# Enable persistent connections (recommended for production)
DB_PERSISTENT=false
# Connection timeout in seconds
DB_TIMEOUT=5
# Enable emulated prepares for better performance
DB_EMULATE_PREPARES=true
# Minimum connections in pool
DB_POOL_MIN=2
# Maximum connections in pool
DB_POOL_MAX=10
# Sticky connections (keep same connection for request)
DB_STICKY=false
# Read/Write timeout in seconds
DB_READ_WRITE_TIMEOUT=60

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue Configuration
# sync: Jobs run immediately (no queue worker needed) - Good for development
# database: Jobs queued in database (requires queue worker) - Good for production
# redis: Jobs queued in Redis (requires Redis + queue worker) - Best for production
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Azure AD Configuration
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Email Scheduler CKD - koneksi database sumber data
DB_CKD_DRIVER=pgsql
DB_CKD_HOST=
DB_CKD_PORT=5432
DB_CKD_DATABASE=
DB_CKD_USERNAME=
DB_CKD_PASSWORD=

# Email Scheduler CKD - Microsoft Graph OAuth (no-reply@mazda.co.id)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=no-reply@mazda.co.id
MS_GRAPH_FROM_NAME="WRS Connect"
MS_GRAPH_PROXY=

# WRS Connect After Sales - login driver: local (tabel ms_afsel_*_user + RBAC) | api (API_SERVICE lama)
AFSEL_AUTH_DRIVER=local
AFSEL_MAX_LOGIN_ATTEMPTS=5
AFSEL_LOCKOUT_MINUTES=15
# Foto Dealer Personel: template URL / path file foto WRS. Placeholder {id} {picture} {ext}. Kosong = avatar inisial.
AFSEL_PERSONEL_PHOTO_SOURCE="storage/app/private/afsel/dealer_personil_aftersales/{id}{ext}"
# Tautan "Contact Support" di halaman login After Sales (mis. mailto:it@domain.com). Kosong = tanpa tautan.
AFSEL_SUPPORT_URL=

# WRS Connect Sales (/sales) - login driver: db (langsung ke DB WRS Sales tblatpm_user/tbldealer_user) | api (API_SERVICE lama)
SALES_AUTH_DRIVER=db
SALES_AUTH_CONNECTION=db_wrs_sales
SALES_MAX_LOGIN_ATTEMPTS=10
# RBAC Sales: role otomatis saat login pertama (kosong = user tanpa role ditolak), TTL cache & cek status user (detik)
SALES_DEFAULT_ROLE_ATPM=
SALES_DEFAULT_ROLE_DEALER=dealer-user
SALES_RBAC_CACHE_TTL=3600
SALES_USER_CHECK_TTL=60

# Sync WRS Sales -> WRS Connect After Sales (php artisan sync-wrs:run inventory|faktur)
# Koneksi sumber diatur di menu Utility > Koneksi Database Sync (tabel ms_sync_db_connection).
# DB_WRSSALES_HOST/PORT/DATABASE/USERNAME/PASSWORD hanya dipakai sekali untuk mengisi awal baris WRS_SALES saat migrate.
SYNC_WRS_INVENTORY_CRON="0 3 * * *"
SYNC_WRS_FAKTUR_CRON="0 7-23 * * *"
SYNC_WRS_CHUNK=1000

# Sync WRS Connect After Sales -> MSI / Customer CSI (php artisan sync-msi:run), pengganti upload_customer_csi.php
# Koneksi tujuan diatur di menu Utility > Koneksi Database Sync (baris MSI, driver SQL Server).
# DB_MSI_* hanya dipakai sekali untuk mengisi awal baris MSI saat migrate (boleh dikosongkan, isi lewat menu).
DB_MSI_HOST=
DB_MSI_PORT=1433
DB_MSI_DATABASE=
DB_MSI_USERNAME=
DB_MSI_PASSWORD=
SYNC_MSI_CRON="0 21 * * *"
# ODBC Driver 18 default Encrypt=yes; server MSI tanpa TLS -> no
SYNC_MSI_SQLSRV_ENCRYPT=no
SYNC_MSI_SQLSRV_TRUST_CERT=true
# true = baris sukses (INSERT/UPDATE) juga dicatat di tr_sync_msi_log_detail
SYNC_MSI_LOG_SUCCESS_ROWS=false
